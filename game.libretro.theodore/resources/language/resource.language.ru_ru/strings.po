msgctxt "Addon Summary"
msgid "Thomson - MO/TO (Theodore)"
msgstr ""

msgctxt "Addon Description"
msgid "Theodore is an emulator for Thomson MO/TO computers.[CR][CR]Thomson MO/TO is a family of 8-bit home computers produced by French company Thomson SA between 1982 and 1989."
msgstr "Theodore — это эмулятор компьютеров Thomson MO/TO.[CR][CR]Thomson MO/TO — это семейство 8-битных домашних компьютеров, выпускавшихся французской компанией Thomson SA с 1982 по 1989 год."

msgctxt "#30001"
msgid "Thomson model"
msgstr "Модель Thomson"

msgctxt "#30002"
msgid "Auto run game"
msgstr "Автозапуск игры"

msgctxt "#30003"
msgid "Use game hash for autostart"
msgstr "Использовать хеш игры для автозапуска"

msgctxt "#30004"
msgid "Display hint to start a game"
msgstr "Показывать подсказку для запуска игры"

msgctxt "#30005"
msgid "Virtual keyboard transparency"
msgstr "Прозрачность виртуальной клавиатуры"

msgctxt "#30006"
msgid "Floppy write protection"
msgstr "Защита дискет от записи"

msgctxt "#30007"
msgid "Tape write protection"
msgstr "Защита кассет от записи"

msgctxt "#30008"
msgid "Dump printer data to file"
msgstr "Сбрасывать данные принтера в файл"

