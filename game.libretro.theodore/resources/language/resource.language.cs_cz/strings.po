msgctxt "Addon Summary"
msgid "Thomson - MO/TO (Theodore)"
msgstr ""

msgctxt "Addon Description"
msgid "Theodore is an emulator for Thomson MO/TO computers.[CR][CR]Thomson MO/TO is a family of 8-bit home computers produced by French company Thomson SA between 1982 and 1989."
msgstr "Theodore je emulátor počítačů Thomson MO/TO.[CR][CR]Thomson MO/TO je řada 8bitových domácích počítačů vyráběných francouzskou společností Thomson SA v letech 1982 až 1989."

msgctxt "#30001"
msgid "Thomson model"
msgstr "Model Thomson"

msgctxt "#30002"
msgid "Auto run game"
msgstr "Automaticky spustit hru"

msgctxt "#30003"
msgid "Use game hash for autostart"
msgstr "Používat hash hry pro automatické spuštění"

msgctxt "#30004"
msgid "Display hint to start a game"
msgstr "Zobrazit nápovědu ke spuštění hry"

msgctxt "#30005"
msgid "Virtual keyboard transparency"
msgstr "Průhlednost virtuální klávesnice"

msgctxt "#30006"
msgid "Floppy write protection"
msgstr "Ochrana diskety proti zápisu"

msgctxt "#30007"
msgid "Tape write protection"
msgstr "Ochrana pásky proti zápisu"

msgctxt "#30008"
msgid "Dump printer data to file"
msgstr "Ukládat data tiskárny do souboru"
